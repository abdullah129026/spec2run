{
  "openapi": "3.0.0",
  "info": {"title": "Bookstore", "version": "1.0.0"},
  "paths": {
    "/books": {"get": {"responses": {"200": {"description": "ok"}}}},
    "/authors": {"get": {"responses": {"200": {"description": "ok"}}}},
    "/orders": {"get": {"responses": {"200": {"description": "ok"}}}}
  },
  "components": {"schemas": {
    "Book": {"type": "object", "required": ["title", "price"], "properties": {
      "id": {"type": "integer"}, "title": {"type": "string"},
      "price": {"type": "number"}, "in_print": {"type": "boolean"},
      "author_id": {"type": "integer"}}},
    "Author": {"type": "object", "required": ["name"], "properties": {
      "id": {"type": "integer"}, "name": {"type": "string"}}},
    "Order": {"type": "object", "required": ["book_id", "quantity"], "properties": {
      "id": {"type": "integer"}, "book_id": {"type": "integer"},
      "quantity": {"type": "integer"}}}
  }}
}
